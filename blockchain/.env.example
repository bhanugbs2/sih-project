# HoneyChain Hardhat Blockchain Deployment Environment Template

# Hardhat Node RPC URL
HARDHAT_RPC_URL=http://127.0.0.1:8545

# EVM Testnet RPC URL (e.g. Sepolia / Polygon Amoy)
TESTNET_RPC_URL=https://rpc.sepolia.org

# Deployer Private Key (Keep secret! NEVER commit real private key)
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_prefix_here

# Etherscan / Polygonscan API Key for verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
