# HoneyChain ESP32 IoT Node Environment Configuration Template
# Rename this file to '.env' or copy variables into platformio.ini

# Wi-Fi Network Credentials
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Spring Boot Backend API Ingestion URL
# Replace 192.168.1.100 with your developer host PC's Local Area Network (LAN) IP address.
# Note: 'localhost' cannot be used on ESP32 because 'localhost' refers to the ESP32 chip itself.
HONEYCHAIN_API_URL=http://192.168.1.100:8080/api/sensors

# Target Physical Hive Identifier (Configurable)
HIVE_ID=hive-001

# IoT Machine-to-Machine Ingestion Security Key
IOT_API_KEY=HoneyChain-IoT-Device-Key-2026
