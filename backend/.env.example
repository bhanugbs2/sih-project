# HoneyChain Backend Environment Configuration Template

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=honeychain_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Flyway Configuration
FLYWAY_ENABLED=true

# Security & JWT Secrets (Phase 2+)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# Blockchain RPC Provider URL (Phase 3+)
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
