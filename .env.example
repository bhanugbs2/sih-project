# HoneyChain System Environment Configuration Template (SIH26021 - Team Nexora)

# Backend Application Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/honeychain_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Flyway Database Migration
FLYWAY_ENABLED=true

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# Blockchain Layer Configuration
BLOCKCHAIN_NETWORK=local-evm
BLOCKCHAIN_ENABLED=true
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# AI / ML Model Configuration
AI_MODEL_PATH=ai/models/honey_purity_v1.onnx
AI_LIBRARY=Tribuo
